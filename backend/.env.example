# MetriGuard Backend - Native Windows Environment Configuration

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database (SQLite with aiosqlite for native Windows local execution)
# Relative to backend/ directory
DATABASE_URL=sqlite+aiosqlite:///./data/metriguard.db

# Storage configuration (Local filesystem abstraction under backend/storage/)
STORAGE_TYPE=local
STORAGE_DIR=./storage

# AI Extractor (Set to true to bypass heavy local OCR and use mock declarations)
USE_MOCK_EXTRACTOR=false
